#================================================
#------------ ASAP7 LVS RULE DECK ---------------
#================================================
# Required inputs:
#  input          - input gds/oas
#  schematic      - reference netlist (spice/cdl) to compare against
# Optional inputs:
#  topcell        - topcell (defaults to the layout's top cell)
#  report         - path to the LVS database report
#  target_netlist - path for the extracted netlist
#  threads        - number of threads to use
#  run_mode       - "deep" (hierarchical, the default) or "flat". Flat is a
#                   debugging aid only: it is impractically slow on anything
#                   larger than a handful of cells.
#  blackbox       - ';'-separated list of cell name globs whose contents are
#                   dropped from both the layout and the reference netlist,
#                   leaving only their pins. Use this to check that the routing
#                   and the row abutment implement the netlist without also
#                   re-checking cell internals -- see the README for the cells
#                   whose CDL is not structurally isomorphic to their layout.
#                   A glob must not match the top cell. A black-boxed run does
#                   not verify cell internals; run the deck per cell for that.
#                   Name the granularity the run is about: on a single hardened
#                   block that is the standard cells, but on an array of abutted
#                   blocks it is the block cells -- blanking standard cells there
#                   still extracts and compares every block interior.
#
# Relative paths given to KLayout's schematic()/target_netlist() are resolved
# against the *layout* directory, not the working directory, so every path
# parameter is expanded here. Callers are still advised to pass absolute paths.
#
# Layer numbers are taken from the ASAP7 design rule manual
# (base/docs/asap7_drm_201207a.pdf, Table 2.1.1 for FEOL) and base/setup/
# klayout/asap7.lyp. Names in asap7_tech.lef, asap7.lyp and asap7.lyt disagree
# with each other, so this deck keys off GDS layer numbers only.
#
# Devices: ASAP7 defines exactly eight devices -- nmos/pmos in rvt, lvt, slvt
# and sram threshold flavors (see base/spice/hspice/7nm_TT_160803.pm). It
# defines no resistors, capacitors, diodes or BJTs, and no marker layers for
# them, so this deck deliberately extracts no passive devices.
#
# Known limitations: 192 of the 209 cells in the RVT standard cell library
# compare clean. The rest fail because the ASAP7 CDL is a schematic-level netlist
# that is electrically equivalent to the layout but not structurally isomorphic
# to it -- either the layout folds a device into multiple fingers where the CDL
# describes it unfolded, or a series stack is drawn in a different order. See the
# README next to this deck for the cell lists and details. At block level the
# blackbox parameter sidesteps this, at the price of not checking cell internals.

#================================================
#----------------- FILE SETUP -------------------
#================================================

raise "no input layout given (-rd input=<file>)" unless $input

if $topcell
  source(File.expand_path($input), $topcell)
else
  source(File.expand_path($input))
end

report_lvs($report ? File.expand_path($report) : source.cell_name + ".lvsdb")

target_netlist($target_netlist ? File.expand_path($target_netlist) :
                                 source.cell_name + "_extracted.cir")

raise "no schematic netlist given (-rd schematic=<file>)" unless $schematic
schematic(File.expand_path($schematic))

threads($threads ? $threads.to_i : 4)

# Hierarchical mode: standard cells are compared cell by cell.
case ($run_mode || "deep")
when "deep" then deep
when "flat" then flat
else raise "unknown run_mode '#{$run_mode}' (expected deep or flat)"
end

#================================================
#------------- LAYERS DEFINITIONS ---------------
#================================================

nwell     = polygons(1, 0)
nwell_lbl = labels(1, 251)
psub_lbl  = labels(3, 251)
gate      = polygons(7, 0)
gcut      = polygons(10, 0)
active    = polygons(11, 0)
nselect   = polygons(12, 0)
pselect   = polygons(13, 0)
lig       = polygons(16, 0)
lisd      = polygons(17, 0)
v0        = polygons(18, 0)
m1        = polygons(19, 0)
m1_lbl    = labels(19, 251)
m2        = polygons(20, 0)
m2_lbl    = labels(20, 251)
v1        = polygons(21, 0)
v2        = polygons(25, 0)
m3        = polygons(30, 0)
m3_lbl    = labels(30, 251)
v3        = polygons(35, 0)
m4        = polygons(40, 0)
m4_lbl    = labels(40, 251)
v4        = polygons(45, 0)
m5        = polygons(50, 0)
m5_lbl    = labels(50, 251)
v5        = polygons(55, 0)
m6        = polygons(60, 0)
m6_lbl    = labels(60, 251)
v6        = polygons(65, 0)
m7        = polygons(70, 0)
m7_lbl    = labels(70, 251)
v7        = polygons(75, 0)
m8        = polygons(80, 0)
m8_lbl    = labels(80, 251)
v8        = polygons(85, 0)
m9        = polygons(90, 0)
m9_lbl    = labels(90, 251)
v9        = polygons(95, 0)
sdt       = polygons(88, 0)
slvt      = polygons(97, 0)
lvt       = polygons(98, 0)
sramvt    = polygons(110, 0)

# Note: dummy poly (8/0) is intentionally not read. It is not a conductor and
# never forms a device gate.

#================================================
#------------- LAYER DERIVATIONS ----------------
#================================================

# GATE metal is physically severed by GCUT, so only the cut result is a
# conductor. Skipping this subtraction lets the full-cell-width LIG power rails
# short every gate line in the cell together.
poly = gate - gcut

# Source/drain diffusion, split by implant and excluding the channel. These are
# also the device terminal layers, so they must appear in the connectivity
# below -- connecting raw ACTIVE instead leaves the S/D terminals unconnected.
nsd = (active & nselect) - poly
psd = (active & pselect) - poly

# Device channels, per implant then per threshold flavor. RVT carries no marker
# layer, so it is whatever is left once SLVT, LVT and SRAMVT are removed.
ngate_all = poly & active & nselect
pgate_all = poly & active & pselect

ngate = {}
pgate = {}
ngate["lvt"]  = ngate_all & lvt
pgate["lvt"]  = pgate_all & lvt
ngate["slvt"] = ngate_all & slvt
pgate["slvt"] = pgate_all & slvt
ngate["sram"] = ngate_all & sramvt
pgate["sram"] = pgate_all & sramvt
ngate["rvt"]  = ngate_all - lvt - slvt - sramvt
pgate["rvt"]  = pgate_all - lvt - slvt - sramvt

# Standard cells carry no physical well/substrate taps; base/README.md states
# that the well and p_sub pins stand in for them and are to be tied by name.
# Neither does TAPCELL, so there is no physical tie anywhere in the hierarchy
# and both the well and the substrate must be global nets -- see CONNECTIVITY.
sub = polygon_layer

#================================================
#---------------- CONNECTIVITY ------------------
#================================================

# Diffusion reaches local interconnect only through the source/drain trench.
connect(nsd, sdt)
connect(psd, sdt)
connect(sdt, lisd)

# Gate metal reaches local interconnect only through LIG.
connect(poly, lig)

# LIG and LISD are the same physical local-interconnect layer, split across two
# GDS layers by function, and they overlap at the power rails -- that overlap is
# how the NMOS source reaches VSS and the PMOS source reaches VDD. Connect them
# to each other rather than merging them into one layer: merging would let
# LISD contact gate metal and LIG contact diffusion, shorting input to output.
connect(lig, lisd)

connect(lig, v0)
connect(lisd, v0)
connect(v0, m1)
connect(m1, v1)
connect(v1, m2)
connect(m2, v2)
connect(v2, m3)
connect(m3, v3)
connect(v3, m4)
connect(m4, v4)
connect(v4, m5)
connect(m5, v5)
connect(v5, m6)
connect(m6, v6)
connect(v6, m7)
connect(m7, v7)
connect(v7, m8)
connect(m8, v8)
connect(v8, m9)
# The stack terminates at V9. ASAP7 gives the Pad layer no drawing layer of its
# own: asap7.lyp has no Pad entry, asap7.layermap maps only Pad *names* onto
# 95/251, and asap7.lyt names Pad in its connectivity without defining a symbol
# for it. There is therefore nothing above V9 to connect to.
connect(m9, v9)

# Attach labels. Port names live on the <metal>/251 pin layers as text objects;
# the M1 label layer (19/2) is empty in the shipped standard cells.
#
# The whole stack is read, not just M1. A standard cell happens to carry its pin
# labels on M1 only, but a *block*'s ports are wherever its pin geometry lands,
# and for a design that abuts hardened blocks that is the upper metals -- a tile
# whose boundary pins are on M4/M5 loses every pin name if only 19/251 is read,
# and a block whose ports are all above M1 loses its pins outright.
#
# This is a soundness fix as much as an enabling one: KLayout treats unnamed pins
# as equivalent while named pins must correspond exactly, so an abstract circuit
# (see BLACK BOXES) whose pins went unnamed can match positionally on the wrong
# pins and report a false clean.
connect(m1, m1_lbl)
connect(m2, m2_lbl)
connect(m3, m3_lbl)
connect(m4, m4_lbl)
connect(m5, m5_lbl)
connect(m6, m6_lbl)
connect(m7, m7_lbl)
connect(m8, m8_lbl)
connect(m9, m9_lbl)
connect(nwell, nwell_lbl)

# Substrate and well are tied by name, per base/README.md. Both are declared
# global, and both are also joined implicitly to the identically named rail.
#
# The global is what makes hierarchy work. A label-only tie is enough when the
# cell is the top cell, because inside the cell both the well net (1/251 label)
# and the M1 rail (19/251 label) are named VDD. One level up the well net has no
# label of its own, so the implicit join cannot be made there, and KLayout
# reports the cell's unsatisfied must-connect requirement as an extraction
# error. connect_global names the net in every circuit; connect_implicit then
# unites it with the rail of the same name inside each circuit, and that is what
# satisfies must-connect at every level up to the top cell.
#
# The two are needed together: the global alone leaves the well and the rail as
# separate same-named nets, which surface as duplicate VDD/VSS pins that the
# four-pin CDL cannot match.
#
# These names are the ones the standard cells label their rails with, so they
# are deliberately not parameterized: renaming them would break the in-cell
# join that the whole scheme rests on.
connect_global(sub,   "VSS")
connect_global(nwell, "VDD")
connect_implicit("VDD")
connect_implicit("VSS")

#================================================
#------------------ DEVICES ---------------------
#================================================

["rvt", "lvt", "slvt", "sram"].each do |vt|
  extract_devices(mos4("nmos_#{vt}"), { "SD" => nsd, "G" => ngate[vt],
                                        "tS" => nsd, "tD" => nsd,
                                        "tG" => poly, "W" => sub })
  extract_devices(mos4("pmos_#{vt}"), { "SD" => psd, "G" => pgate[vt],
                                        "tS" => psd, "tD" => psd,
                                        "tG" => poly, "W" => nwell })
end

#================================================
#---------------- NETLIST SETUP -----------------
#================================================

align

netlist.make_top_level_pins
netlist.combine_devices

#================================================
#----------------- BLACK BOXES -----------------
#================================================

# Drop the contents of the named cells from both netlists, keeping their pins.
# What remains to compare is the parent's connectivity: whether the routing and
# the row abutment implement the netlist.
#
# This runs *before* simplify/purge, as the KLayout manual requires: blank_circuit
# sets a flag that prevents an abstract circuit from being purged, so a blanked
# circuit that is emptied first can simply be purged away instead.
if $blackbox
  top_cell = source.cell_name
  blanked = []

  $blackbox.split(";").each do |glob|
    pattern = glob.strip
    next if pattern.empty?

    # Blanking the top cell on both sides leaves nothing to compare, and the
    # compare then trivially passes. Refuse rather than report a false clean.
    if File.fnmatch(pattern, top_cell, File::FNM_CASEFOLD)
      raise "blackbox glob '#{pattern}' matches the top cell '#{top_cell}': " \
            "blanking the top cell compares nothing"
    end

    # blank_circuit matches case sensitively, and the CDL reader upcases circuit
    # names while the layout keeps the GDS spelling. Both spellings have to be
    # given or only one side of the compare is blanked, which shows up as a
    # mismatch rather than as an error.
    blank_circuit(pattern)
    blank_circuit(pattern.upcase) if pattern.upcase != pattern
    blanked << pattern
  end

  # A black-boxed result is a weaker claim than a plain one, so say so in the log.
  unless blanked.empty?
    puts "LVS_BLACKBOX: #{blanked.join(' ')}"
    puts "LVS_BLACKBOX_NOTE: cell internals were not compared for these globs"
  end
end

#================================================
#---------------- NETLIST REDUCTION -------------
#================================================

netlist.simplify
netlist.purge

schematic.simplify

#================================================
#-------------------- COMPARE -------------------
#================================================

# compare() has side effects; call it exactly once.
if compare
  puts "LVS_RESULT: MATCH"
else
  puts "LVS_RESULT: MISMATCH"
  raise "LVS mismatch: layout and schematic do not match"
end
