<?xml version="1.0" encoding="utf-8"?>
<!--
  KLayout technology for ICsprout55.

  The ICsprout55 release ships a tech LEF that names layers (ACT/POLY/MET1..MET5)
  and a GDS that carries bare numbers, with nothing upstream connecting the two.
  The map below was recovered from the released GDS itself and cross-checked
  against the tech LEF:

    * MET2 is 82 and VIA1 is 91 - the intuitive reading has these swapped. The
      _M2 pin-access variant of the standard cell GDS carries exactly one metal
      layer above MET1 (82/1, min dimension 0.100um = MET2 WIDTH) and one cut
      layer (91/1, 0.090um = VIA1 WIDTH).
    * MET3/MET4/MET5 (83/84/85) and VIA2/VIA3/VIA4 (92/93/94) follow the same
      pattern in the IO GDS, whose cut layers are all 0.090um.
    * All drawing geometry is on datatype 1, not 0. Pin text is on datatype 6,
      labels on datatype 2, cell outlines on 351/12.

  Getting this wrong is silent: a swapped map writes routed MET2 onto a via
  layer, write.gds still succeeds, and no DRC deck exists to catch it.
-->
<technology>
 <name>ICSPROUT55</name>
 <description>ICsprout 55nm Open Source PDK</description>
 <dbu>0.001</dbu>
 <base-path></base-path>
 <original-base-path></original-base-path>
 <add-other-layers>true</add-other-layers>
 <reader-options>
  <gds2>
   <box-mode>1</box-mode>
   <allow-big-records>true</allow-big-records>
   <allow-multi-xy-records>true</allow-multi-xy-records>
  </gds2>
  <common>
   <create-other-layers>true</create-other-layers>
   <layer-map>layer_map()</layer-map>
   <enable-properties>true</enable-properties>
   <enable-text-objects>true</enable-text-objects>
  </common>
  <lefdef>
   <read-all-layers>true</read-all-layers>
   <layer-map>layer_map('DIEAREA : 351/12';'BOUNDARY : 351/12';'ACT : 2/1';'NW1 : 9/1';'POLY : 41/1';'NP : 52/1';'PP : 53/1';'CT : 72/1';'MET1 : 81/1';'MET1.LABEL : 81/2';'MET1.PIN : 81/6';'MET2 : 82/1';'MET2.LABEL : 82/2';'MET2.PIN : 82/6';'MET3 : 83/1';'MET3.LABEL : 83/2';'MET3.PIN : 83/6';'MET4 : 84/1';'MET4.LABEL : 84/2';'MET4.PIN : 84/6';'MET5 : 85/1';'MET5.LABEL : 85/2';'MET5.PIN : 85/6';'T4M2 : 103/1';'T4M2.LABEL : 103/2';'T4M2.PIN : 103/6';'VIA1 : 91/1';'VIA2 : 92/1';'VIA3 : 93/1';'VIA4 : 94/1';'T4V2 : 113/1')</layer-map>
   <dbu>0.001</dbu>
   <produce-net-names>true</produce-net-names>
   <net-property-name>#1</net-property-name>
   <produce-inst-names>true</produce-inst-names>
   <inst-property-name>#1</inst-property-name>
   <produce-cell-outlines>true</produce-cell-outlines>
   <cell-outline-layer>DIEAREA</cell-outline-layer>
   <produce-placement-blockages>true</produce-placement-blockages>
   <placement-blockage-layer>PLACEMENT_BLK</placement-blockage-layer>
   <produce-regions>true</produce-regions>
   <region-layer>REGIONS</region-layer>
   <produce-via-geometry>true</produce-via-geometry>
   <via-geometry-suffix></via-geometry-suffix>
   <via-geometry-datatype>1</via-geometry-datatype>
   <produce-pins>true</produce-pins>
   <pins-suffix>.PIN</pins-suffix>
   <pins-datatype>6</pins-datatype>
   <produce-obstructions>true</produce-obstructions>
   <obstructions-suffix>.OBS</obstructions-suffix>
   <obstructions-datatype>3</obstructions-datatype>
   <produce-blockages>true</produce-blockages>
   <blockages-suffix>.BLK</blockages-suffix>
   <blockages-datatype>4</blockages-datatype>
   <produce-labels>true</produce-labels>
   <labels-suffix>.LABEL</labels-suffix>
   <labels-datatype>2</labels-datatype>
   <produce-routing>true</produce-routing>
   <routing-suffix></routing-suffix>
   <routing-datatype>1</routing-datatype>
  </lefdef>
 </reader-options>
 <writer-options>
  <gds2>
   <write-timestamps>true</write-timestamps>
   <write-cell-properties>false</write-cell-properties>
   <write-file-properties>false</write-file-properties>
   <no-zero-length-paths>false</no-zero-length-paths>
   <multi-xy-records>false</multi-xy-records>
   <max-vertex-count>8000</max-vertex-count>
   <max-cellname-length>32000</max-cellname-length>
   <libname>LIB</libname>
  </gds2>
 </writer-options>
 <connectivity>
  <symbolic></symbolic>
 </connectivity>
</technology>
